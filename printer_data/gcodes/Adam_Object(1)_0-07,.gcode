;
;
; Ender 3 Custom Start G-code (Converted for Klipper) 2025-12-26 M117 Starting
M117 Reset Extruder
G92 E0 ; Reset Extruder
M104 S175  ; Start heating the nozzle
M140 S60 ; start bed heating
START_PRINT
G1 Z5.0 F3000 ; Move Z Axis up a bit during heating to not damage bed
M117 Waiting For Temps
M118 Waiting for Temps
M109 S200 ; Wait For Nozzle to get to Full Temp
M190 S60 ; wait for bed to come up to full temp
M117 Temps OK, Starting Print
M118 Temps OK, Starting Print
MATERIAL_PARTICULARS MATERIAL=PLA
;
;	MATERIAL_OFFSET MATERIAL=PLA
;	MATERIAL_OFFSET MATERIAL=PETG
;	MATERIAL_OFFSET MATERIAL=TPU
;
G1 Z2.0 F3000 ; Move Z Axis up little to prevent scratching of Heat Bed
G1 X0.1 Y20 Z0.3 F5000.0 ; Move to start position
G1 X0.1 Y200.0 Z0.3 F1500.0 E15 ; Draw the first line
G1 X0.4 Y200.0 Z0.3 F5000.0 ; Move to side a little
G1 X0.4 Y20 Z0.3 F1500.0 E30 ; Draw the second line

G92 E0 ; Reset Extruder
G1 Z2.0 F3000 ; Move Z Axis up little to prevent scratching of Heat Bed
G1 X5 Y20 Z0.3 F5000.0 ; Move over to prevent blob squish
M82 ;absolute extrusion mode
M83 ;relative extrusion mode

;; End Of Start G-Code
;
;
M82 ;absolute extrusion mode
G92 E0
G92 E0
G1 F1500 E-6.5
